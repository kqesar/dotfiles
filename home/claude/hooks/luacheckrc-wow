-- Configuration luacheck de repli pour les addons World of Warcraft.
--
-- Utilisée par le hook wow-lint.sh quand le projet n'a pas son propre
-- .luacheckrc. Un projet qui en fournit un garde toujours la main.
--
-- Parti pris : ne signaler que ce qui est réellement un défaut. L'API Blizzard
-- compte plusieurs milliers de globales, impossible à énumérer sans produire un
-- torrent de faux positifs. On tolère donc les globales PascalCase inconnues
-- (code 113) — sauf les namespaces `C_*`, qui eux sont listés exhaustivement
-- pour que `C_Speell.Foo()` soit attrapé comme la faute de frappe qu'il est.
--
-- La liste des namespaces a été extraite du code réellement installé sous
-- Interface/AddOns/ sur le patch 12.1.0, pas reconstituée de mémoire.

std = "lua51"

-- Absent du bac à sable Lua de WoW : le signaler tôt évite un runtime error.
not_globals = { "io", "require", "module", "dofile", "loadfile", "package" }

max_line_length = false

ignore = {
	-- Globales PascalCase inconnues : API Blizzard non énumérée ici.
	-- Le motif exclut délibérément les `C_*` (voir read_globals plus bas).
	"113/[A-BD-Za-z].*",
	"113/C[^_].*",
	-- Champs inconnus sur une globale connue : même raison.
	"143/[A-BD-Za-z].*",
	"143/C[^_].*",
	-- Argument inutilisé nommé `self` ou préfixé `_`.
	"212/self",
	"212/_.*",
}

